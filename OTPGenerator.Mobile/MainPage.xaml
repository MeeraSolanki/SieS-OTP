<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="OTPGenerator.Mobile.MainPage"
             BackgroundColor="{StaticResource AppBeige}"
             Title="SieS OTP"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalOptions="Center">
        <VerticalStackLayout Padding="24" Spacing="20" WidthRequest="320" HorizontalOptions="Center">
            
            <!-- Header Block -->
            <VerticalStackLayout Spacing="4" HorizontalOptions="Center" Margin="0,0,0,10">
                <Label Text="SieS OTP"
                       FontFamily="Segoe UI"
                       FontAttributes="Bold"
                       FontSize="28"
                       TextColor="#DAA520"
                       HorizontalOptions="Center" />
                <Label Text="Generate a one-time password"
                       FontFamily="Segoe UI"
                       FontSize="13"
                       TextColor="AntiqueWhite"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>

            <!-- Error Banner -->
            <Border x:Name="ErrorBorder"
                    Stroke="#FFD700"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 8"
                    BackgroundColor="#FFF3CD"
                    Padding="12,10"
                    IsVisible="False">
                <Grid ColumnDefinitions="30,*">
                    <Label Grid.Column="0" Text="⚠" TextColor="#856404" FontSize="16" VerticalOptions="Center" HorizontalOptions="Center"/>
                    <Label Grid.Column="1" x:Name="lblErrorMessage" Text="" TextColor="#856404" FontSize="13" LineBreakMode="WordWrap" VerticalOptions="Center"/>
                </Grid>
            </Border>

            <!-- User ID Input Field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="User ID"
                       FontFamily="Segoe UI"
                       FontAttributes="Bold"
                       FontSize="13"
                       TextColor="AntiqueWhite" />
                <Border Stroke="#E0D88F"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        Padding="12,2">
                    <Grid ColumnDefinitions="30,*">
                        <Label Grid.Column="0" Text="👤" TextColor="#C8A800" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1"
                               x:Name="entUserId"
                               Placeholder="Enter User ID"
                               TextColor="#2C2C2C"
                               PlaceholderColor="#AAAAAA"
                               FontFamily="Segoe UI"
                               FontSize="14"
                               VerticalOptions="Center"
                               TextChanged="entUserId_TextChanged" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Date Picker Field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Select Date"
                       FontFamily="Segoe UI"
                       FontAttributes="Bold"
                       FontSize="13"
                       TextColor="AntiqueWhite" />
                <Border Stroke="#E0D88F"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="White"
                        Padding="12,2">
                    <Grid ColumnDefinitions="30,*">
                        <Label Grid.Column="0" Text="📅" TextColor="#C8A800" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <DatePicker Grid.Column="1"
                                    x:Name="dtpDate"
                                    TextColor="#2C2C2C"
                                    FontFamily="Segoe UI"
                                    FontSize="14"
                                    Format="d"
                                    VerticalOptions="Center"
                                    DateSelected="dtpDate_DateSelected" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Generated OTP Output Field -->
            <VerticalStackLayout Spacing="6">
                <Label Text="Generated OTP"
                       FontFamily="Segoe UI"
                       FontAttributes="Bold"
                       FontSize="13"
                       TextColor="AntiqueWhite" />
                <Border Stroke="#E0D88F"
                        StrokeThickness="1.5"
                        StrokeShape="RoundRectangle 10"
                        BackgroundColor="#F9F9F9"
                        Padding="12,2">
                    <Grid ColumnDefinitions="30,*">
                        <Label Grid.Column="0" Text="🔑" TextColor="#C8A800" FontSize="18" VerticalOptions="Center" HorizontalOptions="Center"/>
                        <Entry Grid.Column="1"
                               x:Name="entOTP"
                               IsReadOnly="True"
                               TextColor="#2C2C2C"
                               FontFamily="Segoe UI"
                               FontAttributes="Bold"
                               FontSize="16"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>
            </VerticalStackLayout>

            <!-- Buttons Layout -->
            <Grid ColumnDefinitions="*,12,*" Margin="0,10,0,0">
                
                <!-- Generate Button with Gradient -->
                <Button Grid.Column="0"
                        x:Name="btnGenerate"
                        Text="Generate"
                        TextColor="White"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="46"
                        CornerRadius="10"
                        Clicked="btnGenerate_Clicked">
                    <Button.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FFD700" Offset="0.0"/>
                            <GradientStop Color="#DAA520" Offset="1.0"/>
                        </LinearGradientBrush>
                    </Button.Background>
                    <Button.Shadow>
                        <Shadow Brush="#DAA520" Offset="0,3" Radius="5" Opacity="0.4"/>
                    </Button.Shadow>
                </Button>

                <!-- Copy OTP Button -->
                <Button Grid.Column="2"
                        x:Name="btnCopy"
                        Text="Copy OTP"
                        TextColor="#888888"
                        BackgroundColor="White"
                        BorderColor="#DDDDDD"
                        BorderWidth="1.5"
                        FontAttributes="Bold"
                        FontSize="15"
                        HeightRequest="46"
                        CornerRadius="10"
                        Clicked="btnCopy_Clicked" />
            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
